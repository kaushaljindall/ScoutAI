# ============================================================
# ScoutAI Backend - Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# --- App ---
PROJECT_NAME="ScoutAI"
ENVIRONMENT="development"   # development | production
FRONTEND_URL="http://localhost:3000"

# --- MongoDB Atlas ---
# 1. Go to cloud.mongodb.com → Create free M0 cluster
# 2. Database Access → Add a user (simple password, no special chars)
# 3. Network Access → Allow from Anywhere (0.0.0.0/0)
# 4. Connect → Drivers → Copy your connection string
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/scoutai"
MONGODB_DB_NAME="scoutai"

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="your-secret-key-here"
JWT_SECRET="your-jwt-secret-here"
JWT_REFRESH_SECRET="your-jwt-refresh-secret-here"

# --- AI Integrations ---
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# --- Search Providers ---
# SearXNG: point to your self-hosted instance or leave as public fallback
SEARXNG_BASE_URL="https://searxng.site"

# Brave Search API: https://api.search.brave.com/app/keys
BRAVE_API_KEY=""

# Google Places API (optional): https://console.cloud.google.com/apis/credentials
GOOGLE_PLACES_API_KEY=""
