.installed.cfg
*.egg
MANIFEST

# Environment Variables
backend/.env
backend/.env.*
!backend/.env.example

# Virtual environments
backend/venv/
backend/env/
backend/.venv/
backend/ENV/
backend/env.bak/
backend/venv.bak/
venv 

